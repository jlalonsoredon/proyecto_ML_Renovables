---
import Layout from "../layouts/Layout.astro";
import linea from "../data/spec-timeline.json";

// Títulos de las specs: los diez primeros salen de spec-timeline.json; las posteriores se declaran aquí.
const titulos: Record<string, string> = Object.fromEntries(linea.hitos.map((h) => [h.numero, h.titulo]));
titulos["011"] = "Ventana común de las comparativas";
titulos["012"] = "Rediseño de la interfaz";

// `realizado` y `specs` solo se rellenan en las tareas completadas: dicen qué se hizo y dónde está documentado.
const tareas = [
  {
    titulo: "Incluir datos de producción y previsión de energía hidráulica",
    descripcion: "Incorporar datos de producción y previsión de energía hidráulica para mejorar la precisión de las predicciones y permitir análisis más completos.",
    estado: "pendiente",
    prioridad: "Alta",
    realizado: "",
    specs: [] as string[],
  },
  {
    titulo: "Restyling completo del frontend",
    descripcion: "Actualizar el diseño y la experiencia de usuario del frontend para hacerlo más moderno y atractivo.",
    estado: "completado",
    prioridad: "Media",
    realizado: "Rediseño completo de Inicio, Resultados, Proceso y Mejoras: estilo más moderno, gráficas interactivas con Chart.js, tema claro y oscuro, versión móvil y contenidos más didácticos.",
    specs: ["012"],
  },
  {
    titulo: "Incluir datos de producción y previsión de energía solar",
    descripcion: "Incorporar datos de producción y previsión de energía solar para mejorar la precisión de las predicciones y permitir análisis más completos.",
    estado: "completado",
    prioridad: "Alta",
    realizado: "Integrada como variables del modelo eólico: horas de sol y temperatura del día anterior, más un archivo diario con las previsiones de AEMET.",
    specs: ["002", "003"],
  },
  {
    titulo: "Integrar la previsión de demanda eléctrica de REE",
    descripcion: "Incorporar datos de previsión de demanda eléctrica para mejorar la precisión de las predicciones y permitir análisis más completos.",
    estado: "completado",
    prioridad: "Alta",
    realizado: "Integrada la previsión de REE para el día que se predice (previsión eólica D+1) como variable del modelo.",
    specs: ["004", "005"],
  },
  {
    titulo: "Mejorar el modelo con todos los nuevos datos integrados",
    descripcion: "Incorporar todos los nuevos datos de producción y previsión de energía para mejorar la precisión de las predicciones y permitir análisis más completos.",
    estado: "completado",
    prioridad: "Alta",
    realizado: "El modelo pasó de 16 a 19 variables y su error se redujo a la mitad al incorporar la previsión de REE.",
    specs: ["002", "005", "006"],
  },
];

const realizadas = tareas.filter((t) => t.estado === "completado").length;
const porcentaje = Math.round((realizadas / tareas.length) * 100);
---

<Layout title="Mejoras">
  <main>
    <section class="a-section" style="padding-top: 72px; padding-bottom: 56px">
      <div class="a-wrap" style="display: flex; flex-direction: column; gap: 22px; max-width: 880px">
        <p class="a-eyebrow">Mejoras y futuro</p>
        <h1 class="a-h1">Hoja de ruta del proyecto</h1>
        <p class="a-lead">
          Qué mejoras de AeroPredictor ya están hechas, cuáles quedan por hacer y en qué specs se desarrolló cada una.
          Las marcas son solo informativas: reflejan el estado real del proyecto y no se pueden editar.
        </p>
        <div style="max-width: 520px; margin-top: 10px">
          <div class="num" style="display: flex; justify-content: space-between; gap: 12px; font-size: 14px; font-weight: 600; margin-bottom: 10px">
            <span>{realizadas} de {tareas.length} mejoras realizadas</span>
            <span style="color: var(--muted)">{porcentaje} %</span>
          </div>
          <div role="progressbar" aria-label="Mejoras realizadas" aria-valuemin="0" aria-valuemax="100" aria-valuenow={porcentaje} style="height: 12px; border-radius: 999px; background: var(--surface2); overflow: hidden">
            <div style={`height: 100%; width: ${porcentaje}%; background: var(--accent); border-radius: 999px`}></div>
          </div>
        </div>
      </div>
    </section>

    <section class="a-section">
      <div class="a-wrap">
        <div style="display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; margin-bottom: 28px">
          <h2 class="a-h2">De lo próximo a lo hecho</h2>
          <span class="a-p" style="font-size: 14px">Arriba lo pendiente; debajo, lo ya realizado.</span>
        </div>
        <ol class="ruta">
          {tareas.map((t, i) => {
            const hecha = t.estado === "completado";
            return (
              <li class="paso" data-hecha={hecha ? "si" : "no"}>
                {i < tareas.length - 1 && <span class="riel" aria-hidden="true"></span>}
                <span
                  class="nodo"
                  role="checkbox"
                  aria-checked={hecha ? "true" : "false"}
                  aria-readonly="true"
                  aria-label={`${hecha ? "Realizada" : "Pendiente"}: ${t.titulo}`}
                >
                  {hecha && (
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7" /></svg>
                  )}
                </span>
                <div class="tarjeta">
                  <div style="display: flex; gap: 8px; flex-wrap: wrap">
                    <span class="est">{hecha ? "Completado" : "Pendiente"}</span>
                    <span class="a-chip">Prioridad {t.prioridad}</span>
                  </div>
                  <h3 class="a-h3" style="font-size: 21px">{t.titulo}</h3>
                  <p class="a-p" style="font-size: 15px">{t.descripcion}</p>
                  {hecha && (
                    <div class="nota">
                      <p style="font-size: 14px"><b>Qué se hizo:</b> {t.realizado}</p>
                      {t.specs.length > 0 && (
                        <div>
                          <p class="mini">Specs relacionadas</p>
                          <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-top: 6px">
                            {t.specs.map((s) => (
                              <a class="spec" href="/proceso#evolucion"><b class="num">{s}</b>{titulos[s]}</a>
                            ))}
                          </div>
                        </div>
                      )}
                    </div>
                  )}
                </div>
              </li>
            );
          })}
        </ol>
        <p style="margin-top: 8px"><a class="a-link" href="/proceso#evolucion">Ver todas las specs del proyecto →</a></p>
      </div>
    </section>

    <section class="a-section" style="padding-bottom: 112px">
      <div class="a-wrap">
        <div class="contacto">
          <h2 class="a-h2">¿Tienes sugerencias?</h2>
          <p class="a-lead" style="color: var(--ink); margin: 16px 0 24px">
            Si tienes ideas para mejorar el proyecto o quieres contribuir, no dudes en contactarme a través de LinkedIn.
          </p>
          <a class="a-btn" href="https://www.linkedin.com/in/jose-luis-alonso-redondo/" target="_blank" rel="noopener noreferrer">Contactar en LinkedIn →</a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .ruta { margin: 0; padding: 0; max-width: 860px; list-style: none; }
  .paso { position: relative; padding: 0 0 24px 56px; }
  .riel { position: absolute; left: 13px; top: 54px; bottom: -24px; width: 2px; background: var(--line); }
  .nodo { position: absolute; left: 0; top: 22px; width: 28px; height: 28px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; background: var(--bg); border: 2px dashed var(--warm); }
  .paso[data-hecha="si"] .nodo { background: var(--accent); border: 2px solid var(--accent); color: var(--accentInk); }
  .tarjeta { background: var(--surface); border: 1px solid var(--warm); border-radius: 20px; padding: 24px; display: flex; flex-direction: column; gap: 12px; }
  .paso[data-hecha="si"] .tarjeta { border-color: var(--accent); }
  .est { border: 1px solid var(--warm); color: var(--warm); border-radius: 999px; padding: 3px 12px; font-size: 12px; font-weight: 600; }
  .paso[data-hecha="si"] .est { border-color: var(--accent); color: var(--accent); }
  .nota { margin-top: 6px; padding-top: 16px; border-top: 1px solid var(--line); display: flex; flex-direction: column; gap: 12px; }
  .mini { font-size: 12px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); margin: 0; }
  .spec { display: inline-flex; align-items: center; gap: 8px; min-height: 36px; padding: 0 12px; border: 1px solid var(--line); border-radius: 999px; font-size: 13px; text-decoration: none; }
  .spec b { color: var(--accent); }
  .contacto { background: var(--surface2); border: 1px solid var(--line); border-radius: 32px; padding: clamp(32px, 6vw, 64px); }
</style>
