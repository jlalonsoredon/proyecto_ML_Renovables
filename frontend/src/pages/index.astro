---
import snapshot from "../data/forecast-snapshot.json";
import { cardView } from "../utils/live-prediction.mjs";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/sections/hero/Hero.astro";
import KeyServices from "../components/sections/services/KeyServices.astro";
import GetInvolved from "../components/sections/cta/GetInvolved.astro";
import Container from "../components/shared/Container.astro";
import Title2 from "../components/shared/Title2.astro";
import Title3 from "../components/shared/Title3.astro";
import Paragraph from "../components/shared/Paragraph.astro";
import CtaButton from "../components/shared/CtaButton.astro";
const view = cardView(snapshot);
---

<Layout title="Predicción Eólica ML">
  <main class="flex flex-col gap-y-20 md:gap-y-40 overflow-hidden">
    <!-- 1. CABECERA (Hero original) -->
    <Hero />

    <!-- 2. BLOQUE "Discover Our Cutting-edge Green Energy Technologies" -->
    <!-- <KeyServices /> -->

    <!-- 3. TARJETAS DE RESULTADOS (estilo GetInvolved/Join Us) -->
    <GetInvolved />

    <!-- 4. SECCIÓN DE PREDICCIÓN ACTUAL -->
    <Container>
      <section class="py-12 text-center">
        <Title2>Predicción para Mañana</Title2>
        <div class="grid md:grid-cols-2 gap-8 items-center">
          <div class="text-left">
            <Paragraph>
              Nuestro modelo predictivo utiliza datos meteorológicos de AEMET y
              datos históricos de generación de la API de Red Eléctrica de España
              para estimar la producción eólica del día siguiente.
            </Paragraph>
            <div class="mt-6 text-center">
              <a href="/resultados" class="inline-block bg-primary text-white px-6 py-3 rounded-lg hover:bg-primary-dark transition-colors">
                Ver Todos los Gráficos
              </a>
            </div>
          </div>
          <div
            class="bg-gradient-to-r from-blue-600 to-blue-800 rounded-xl p-8 text-white text-left"
            id="prediction-card"
            data-live-prediction
            data-state={view.estado}
          >
            <Title3 className="text-white">Producción Eólica Prevista</Title3>
            <p class="text-blue-100 text-sm mb-4">Fecha objetivo: <span data-field="fecha">{view.campos.fecha}</span></p>
            <div class="text-5xl font-bold" data-field="valor">{view.campos.valor}</div>
            <div class="text-blue-200 text-xl mt-2">MWh</div>
            <div class="mt-6 grid grid-cols-2 gap-4 text-sm">
              <div>
                <span class="text-blue-200">Velocidad viento:</span>
                <div class="font-semibold" data-field="velmedia">{view.campos.velmedia}</div>
              </div>
              <div>
                <span class="text-blue-200">Ráfagas:</span>
                <div class="font-semibold" data-field="racha">{view.campos.racha}</div>
              </div>
            </div>
            <p class="text-xs text-blue-100 mt-4">
              Modelo: <span data-field="familia">{view.campos.familia}</span> · Variables: <span data-field="variables">{view.campos.variables}</span>
            </p>
            <p class="text-xs text-blue-100 mt-2" data-field="estado" data-tone="none" data-base-class="text-xs text-blue-100 mt-2" role="status" aria-live="polite">
              {view.mensaje}
            </p>
          </div>
        </div>
      </section>
    </Container>

    <!-- 5. SECCIÓN DE PROCESO (CTA final) -->
    <Container>
      <section class="py-12 text-center bg-gray-100 dark:bg-gray-800 rounded-xl">
        <Title2>¿Quieres Saber Cómo Funciona?</Title2>
        <Paragraph>
          Descubre el proceso completo: desde la obtención de datos de las APIs
          hasta la predicción con Machine Learning.
        </Paragraph>
        <div class="flex justify-center mt-6 gap-4">
          <a href="/proceso" class="inline-flex items-center gap-2 bg-primary text-white px-6 py-3 rounded-lg hover:bg-primary-dark transition-colors">
            Ver el Proceso
          </a>
          <a href="/resultados" class="inline-flex items-center gap-2 bg-secondary text-white px-6 py-3 rounded-lg hover:bg-secondary-dark transition-colors">
            Ver Resultados
          </a>
        </div>
      </section>
    </Container>
  </main>
</Layout>

<script>
  import snapshot from "../data/forecast-snapshot.json";
  import { initLivePrediction } from "../utils/live-prediction.mjs";
  initLivePrediction(snapshot);
</script>
