---
import Layout from "../layouts/Layout.astro";
import EnergyPieChart from "../components/charts/EnergyPieChart.astro";
import WindMap from "../components/charts/WindMap.astro";
import EolicaScaledCharts from "../components/charts/EolicaScaledCharts.astro";
import ModelComparisonChart from "../components/charts/ModelComparisonChart.astro";
import RenewableLineChart from "../components/charts/RenewableLineChart.astro";
import FeatureImportanceChart from "../components/charts/FeatureImportanceChart.astro";
import NewVariablesCharts from "../components/charts/NewVariablesCharts.astro";
import SpecTimeline from "../components/evolution/SpecTimeline.astro";
import MetricsComparison from "../components/evolution/MetricsComparison.astro";
import LivePredictionStatus from "../components/evolution/LivePredictionStatus.astro";

const recorrido = [
  { n: "1", t: "Conocer los datos", d: "De dónde vienen y qué miden." },
  { n: "2", t: "Explorarlos (EDA)", d: "Mirar los datos antes de modelar: tendencias, mapa y relación viento–generación." },
  { n: "3", t: "Preparar las variables", d: "Las 19 pistas del modelo y cómo se relacionan las nuevas con la producción." },
  { n: "4", t: "Probar modelos", d: "Ocho familias comparadas con las mismas reglas." },
  { n: "5", t: "Predecir cada día", d: "La cifra de mañana, con avisos claros si falta algo." },
  { n: "6", t: "Cómo se construyó", d: "Con desarrollo guiado por especificaciones (SDD)." },
];

const variables = [
  ["Viento previsto (2)", "Velocidad media y racha máxima previstas por AEMET para el día objetivo."],
  ["Calendario (3)", "Mes, día de la semana y día del año."],
  ["Generación anterior (5)", "Generación eólica de 1, 2, 3 y 7 días antes y su media de 7 días."],
  ["Medias de viento (6)", "Velocidad media y racha de 3, 7 y 14 días."],
  ["Sol y temperatura (2)", "Horas de sol y temperatura media del día anterior."],
  ["Previsión de REE (1)", "Generación eólica prevista por Red Eléctrica para el día objetivo."],
];

const parques = [
  ["El Andévalo", "Huelva", "Alosno"],
  ["Gecama", "Cuenca", "Albacete"],
  ["Maranchón", "Guadalajara", "Molina de Aragón"],
  ["Borja", "Zaragoza", "Tarazona"],
  ["Tarifa", "Cádiz", "Tarifa"],
  ["Briviesca", "Burgos", "Briviesca"],
  ["La Muela", "Zaragoza", "Tarazona"],
];
---

<Layout title="Proceso">
  <main>
    <section class="a-section" style="padding-top: 72px; padding-bottom: 56px">
      <div class="a-wrap" style="display: flex; flex-direction: column; gap: 22px; max-width: 900px">
        <h1 class="a-h1">Cómo se construye la predicción, paso a paso</h1>
        <p class="a-lead">
          Aquí se cuenta, sin tecnicismos, cómo pasamos de datos de Red Eléctrica y AEMET a la cifra de mañana. Las gráficas son interactivas: puedes pulsar la leyenda para ocultar series y tocar o pasar el cursor para ver cada valor.
        </p>
        <a class="a-link" href="#evolucion">Ver la evolución del proyecto y sus métricas ↓</a>
      </div>
    </section>

    <section class="a-section">
      <div class="a-wrap">
        <ol class="recorrido">
          {recorrido.map((r) => (
            <li>
              <span class="num font-display rn">{r.n}</span>
              <h3 class="a-h3" style="margin: 10px 0 6px; font-size: 17px">{r.t}</h3>
              <p class="a-p" style="font-size: 14px">{r.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Situación energética -->
    <section class="a-section">
      <div class="a-wrap">
        <h2 class="a-h2" style="margin: 0 0 14px">¿Cuánta electricidad es renovable?</h2>
        <p class="a-lead" style="margin-bottom: 28px">
          Tras descargar el histórico de generación eléctrica por tecnología desde la API de REE, calculamos qué parte de la electricidad generada en España es renovable y cuánto aporta cada tecnología. Entre enero de 2022 y mayo de 2026, de media, el 58,33 % de la generación procedió de fuentes renovables. La eólica fue la tecnología más representativa, con el 23,41 % del total, seguida de la solar fotovoltaica (19,83 %) y la hidráulica (11,64 %).
        </p>
        <EnergyPieChart />
        <p class="a-p" style="font-size: 13px; margin-top: 10px">Fuente: API Red Eléctrica de España (REE), datos históricos de generación.</p>
      </div>
    </section>

    <!-- 1. Datos -->
    <section class="a-section">
      <div class="a-wrap">
        <h2 class="a-h2" style="margin: 14px 0">Conocer los datos</h2>
        <p class="a-lead" style="margin-bottom: 28px">Un modelo solo es tan bueno como los datos con los que aprende. Usamos dos fuentes oficiales.</p>
        <div class="dos">
          <div class="a-card">
            <h3 class="a-h3">Red Eléctrica de España (REE)</h3>
            <p class="a-p" style="margin: 10px 0">Cuánta electricidad se genera cada día, desglosada por tecnología renovable.</p>
            <ul class="lista">
              <li>Eólica</li><li>Solar fotovoltaica</li><li>Hidráulica</li><li>Solar térmica</li><li>Otras renovables</li><li>Residuos renovables</li>
            </ul>
            <p class="a-p"><b style="color: var(--ink)">Período:</b> enero 2022 – actualidad.</p>
          </div>
          <div class="a-card">
            <h3 class="a-h3">AEMET (meteorología)</h3>
            <p class="a-p" style="margin: 10px 0">Observaciones diarias de 11 estaciones y previsiones de 12 ubicaciones.</p>
            <ul class="lista">
              <li>Temperatura media, mínima y máxima</li><li>Velocidad media del viento</li><li>Ráfaga máxima</li><li>Precipitación</li><li>Horas de sol</li>
            </ul>
            <p class="a-p"><b style="color: var(--ink)">Junto a parques eólicos (6):</b> Alosno, Albacete, Molina de Aragón, Tarazona, Tarifa y Briviesca.</p>
            <p class="a-p" style="margin-top: 6px"><b style="color: var(--ink)">Junto a plantas solares (5):</b> Cáceres, Badajoz, Alcantarilla, Sevilla y Zaragoza.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. EDA -->
    <section class="a-section">
      <div class="a-wrap">
        <h2 class="a-h2" style="margin: 14px 0">Explorar antes de modelar</h2>
        <p class="a-lead" style="margin-bottom: 36px">
          El análisis exploratorio de datos (EDA) consiste en mirar los datos desde varios ángulos antes de construir ningún modelo: cómo cambia la generación con el tiempo, dónde están los parques y si el viento tiene relación con lo que se genera.
        </p>

        <h3 class="a-h3" style="font-size: 24px; margin-bottom: 8px">¿Cómo ha cambiado la generación con el tiempo?</h3>
        <p class="a-p" style="max-width: 70ch; margin-bottom: 20px">
          Generación semanal de las seis tecnologías renovables desde enero de 2022 hasta la última semana completa disponible. Pulsa en la leyenda para mostrar u ocultar una tecnología.
        </p>
        <RenewableLineChart />

        <h3 class="a-h3" style="font-size: 24px; margin: 56px 0 8px">¿Dónde están los parques que miramos?</h3>
        <p class="a-p" style="max-width: 70ch; margin-bottom: 20px">
          Ubicación de los 7 parques eólicos monitorizados, sobre un mapa de referencia, junto con la estación meteorológica de AEMET que se usa para cada uno. Borja y La Muela comparten la de Tarazona: son siete parques y seis estaciones.
        </p>
        <WindMap />
        <ul class="parques">
          {parques.map((p) => (
            <li class="a-card-sm"><b>{p[0]}</b><span class="a-p" style="font-size: 13px; display: block">{p[1]} · estación de {p[2]}</span></li>
          ))}
        </ul>

        <h3 class="a-h3" style="font-size: 24px; margin: 56px 0 8px">¿Se relaciona el viento con lo que se genera?</h3>
        <p class="a-p" style="max-width: 70ch; margin-bottom: 20px">
          Una vez limpios los datos (sin duplicados, con los huecos interpolados y con el viento convertido de km/h a m/s) se dibujan las variables juntas para buscar patrones y anomalías. Si la nube de puntos sube, más viento suele significar más generación.
        </p>
        <EolicaScaledCharts />
      </div>
    </section>

    <!-- 3. Variables -->
    <section class="a-section">
      <div class="a-wrap">
        <h2 class="a-h2" style="margin: 14px 0">Preparar las 19 variables</h2>
        <p class="a-lead" style="margin-bottom: 28px">
          Las variables son las «pistas» que se le dan al modelo para estimar la generación de mañana. Cada una indica si procede de una observación, de una previsión o de una estimación.
        </p>
        <div class="vars">
          {variables.map((v) => (
            <div class="a-card-sm"><b>{v[0]}</b><p class="a-p" style="font-size: 14px; margin-top: 4px">{v[1]}</p></div>
          ))}
        </div>
        <h3 class="a-h3" style="font-size: 24px; margin: 56px 0 8px">Las nuevas variables: sol, temperatura y previsión de REE</h3>
        <p class="a-p" style="max-width: 70ch; margin-bottom: 24px">
          El modelo empezó con 16 variables de viento, calendario y generación anterior. Después se estudiaron tres más. Antes de añadirlas comprobamos, con un punto por día, qué relación tenían con la producción eólica.
        </p>
        <NewVariablesCharts />
        <div style="margin-top: 56px"><FeatureImportanceChart /></div>
      </div>
    </section>

    <!-- 4. Modelos -->
    <section class="a-section">
      <div class="a-wrap">
        <h2 class="a-h2" style="margin: 14px 0">Probar modelos</h2>
        <p class="a-lead" style="margin-bottom: 16px">
          El objetivo es predecir la generación de energía eólica en España con la mayor precisión posible. Se han probado ocho familias de modelos, primero con las 16 variables originales y después con las 19 actuales.
        </p>
        <p class="a-p" style="max-width: 76ch; margin-bottom: 32px">
          <b style="color: var(--ink)">Modelo seleccionado:</b> Linear Regression con 19 variables (R² de 0,9308 en el test de 354 días con el que se evaluó el modelo en producción). Otros modelos, como LightGBM o la red neuronal, tienen menos error en una única partición, pero LightGBM, el mejor candidato evaluado, se descartó porque solo mejoraba en 1 de los 4 años del walk-forward. La tabla completa está en <a class="a-link" href="#evolucion">la evolución del proyecto</a>.
        </p>
        <ModelComparisonChart />
      </div>
    </section>

    <!-- 5. Predicción diaria -->
    <section class="a-section">
      <div class="a-wrap">
        <h2 class="a-h2" style="margin: 14px 0">Predecir cada día</h2>
        <ol class="diario">
          <li><b>Captura de previsiones.</b> Se guardan la previsión meteorológica de AEMET para las 12 ubicaciones y la previsión eólica de REE para el día siguiente.</li>
          <li><b>Actualización de observaciones.</b> Se descargan los datos reales de REE y AEMET. Los días todavía incompletos no se usan.</li>
          <li><b>Construcción de las 19 variables.</b> Cada una indica si procede de una observación, de una previsión o de una estimación.</li>
          <li><b>Predicción y registro.</b> Linear Regression calcula la producción en MWh y se guarda con sus variables. Si falta algún dato, no se publica ninguna cifra en su lugar.</li>
        </ol>
        <p class="a-p" style="margin-top: 18px; max-width: 76ch">
          <b style="color: var(--ink)">Programación:</b> la actualización se ejecuta cada día a las 03:00 (hora peninsular), con un reintento a las 09:00 si la previsión de AEMET llegó incompleta.
        </p>
      </div>
    </section>

    <!-- 6. SDD y evolución -->
    <section id="evolucion" class="a-section" style="scroll-margin-top: 90px">
      <div class="a-wrap">
        <h2 class="a-h2" style="margin: 14px 0">Evolución del proyecto, guiada por especificaciones</h2>
        <div class="a-card" style="margin: 20px 0 32px">
          <h3 class="a-h3">Desarrollo guiado por especificaciones (SDD)</h3>
          <p class="a-p" style="margin-top: 10px; max-width: 76ch">
            AeroPredictor se ha desarrollado con <b style="color: var(--ink)">SDD (Spec-Driven Development)</b>: antes de tocar el código, cada cambio se escribe como una <em>spec</em> con su contexto, sus decisiones, sus criterios de aceptación y sus riesgos, y se divide en tareas verificables. Así cada mejora queda justificada, medida y documentada, y se puede ver qué se decidió y por qué. Cada tarjeta de abajo es una de esas specs.
          </p>
        </div>
        <p class="a-p" style="max-width: 76ch; margin-bottom: 24px">
          El proyecto ha cambiado en diez specs: nuevas fuentes de datos, nuevas variables, una nueva evaluación de familias de modelos, la integración en el servicio y la publicación diaria de la previsión. Así ha llegado hasta aquí.
        </p>

        <SpecTimeline />

        <h3 class="a-h3" style="font-size: 24px; margin: 56px 0 8px">Antes y ahora</h3>
        <p class="a-p" style="margin-bottom: 20px">Cada cifra indica con cuántas variables y en qué periodo se midió.</p>
        <MetricsComparison />

        <div style="margin-top: 40px"><LivePredictionStatus /></div>
      </div>
    </section>

    <section class="a-section" style="padding-bottom: 112px">
      <div class="a-wrap" style="text-align: center">
        <a class="a-btn" href="/resultados">Ver gráficos y predicciones →</a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .recorrido { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(170px, 100%), 1fr)); gap: 20px; }
  .recorrido li { border-top: 1px solid var(--line); padding-top: 16px; }
  .rn { color: var(--accent); font-weight: 600; font-size: 14px; letter-spacing: 0.08em; }
  .dos { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(380px, 100%), 1fr)); gap: 20px; }
  .lista { margin: 0 0 12px; padding-left: 20px; color: var(--muted); }
  .parques { list-style: none; margin: 16px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr)); gap: 12px; }
  .vars { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)); gap: 16px; }
  .diario { margin: 24px 0 0; padding-left: 22px; display: flex; flex-direction: column; gap: 12px; color: var(--muted); max-width: 76ch; }
  .diario b { color: var(--ink); }
</style>
