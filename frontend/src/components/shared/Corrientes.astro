---
// Líneas de corriente decorativas (viento) del lienzo de diseño (spec 017).
// Se generan en el build con una semilla fija; se desplazan despacio salvo con «reducir movimiento».
interface Props {
  ancho?: number;
  alto?: number;
  n?: number;
  semilla?: number;
}
import { smoothPath } from "../../utils/curvas.mjs";

const { ancho = 720, alto = 520, n = 15, semilla = 7 } = Astro.props;

// Generador pseudoaleatorio con semilla (mulberry32): mismo dibujo en cada build.
function generador(seed: number) {
  let a = seed >>> 0;
  return () => {
    a = (a + 0x6d2b79f5) >>> 0;
    let t = a;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const azar = generador(semilla);
const entre = (a: number, b: number) => a + (b - a) * azar();
const elegir = <T,>(lista: T[]) => lista[Math.floor(azar() * lista.length)];

const lineas = Array.from({ length: n }, (_, i) => {
  const y0 = alto * (0.06 + (0.88 * i) / (n - 1)) + entre(-14, 14);
  const amp = entre(18, 70);
  const fase = entre(0, 6.28);
  const pts: [number, number][] = Array.from({ length: 13 }, (_, k) => {
    const x = -20 + ((ancho + 40) * k) / 12;
    return [x, y0 + amp * Math.sin((k / 12) * 3.4 + fase) + (0.12 * (x - ancho / 2) * (i - n / 2)) / n];
  });
  return { d: smoothPath(pts, 0.2), op: elegir([0.14, 0.2, 0.28, 0.42]), sw: elegir([1, 1, 1.4, 2]) };
});
---

<svg class="corrientes deriva" viewBox={`0 0 ${ancho} ${alto}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  {lineas.map((l) => <path d={l.d} fill="none" stroke-width={l.sw} opacity={l.op} stroke-linecap="round" style="stroke: var(--accent)" />)}
</svg>

<style>
  .corrientes { display: block; width: calc(100% + 28px); max-width: none; height: 100%; }
</style>
