---
// Reparto de la generación eléctrica (spec 015): dos anillos de Chart.js con los colores del tema.
// Datos del notebook api.ipynb → df_tabla (porcentaje_medio por tecnología)
// pct_renovable = media histórica de la suma diaria de % renovables en la BD
import series from "../../data/reference-series.json";
import { formatNumber } from "../../utils/evolution.mjs";

const RENOVABLES = [
  { tecnologia: "Eólica",              pct_total: 23.41, pct_reno: 40.16, token: "accent" },
  { tecnologia: "Solar fotovoltaica",  pct_total: 19.83, pct_reno: 34.01, token: "warm" },
  { tecnologia: "Hidráulica",          pct_total: 11.64, pct_reno: 19.97, token: "sky" },
  { tecnologia: "Solar térmica",       pct_total:  1.62, pct_reno:  2.78, token: "coral" },
  { tecnologia: "Otras renovables",    pct_total:  1.55, pct_reno:  2.66, token: "violet" },
  { tecnologia: "Residuos renovables", pct_total:  0.28, pct_reno:  0.48, token: "muted" },
];
const PCT_RENOVABLE = 58.33;
const PCT_NO_RENOVABLE = 41.67;
const { mix } = series;

const pct = (v: number) => `${formatNumber(v, 2)} %`;

// Cada anillo: sus partes (nombre, valor, token de color) y el texto del centro.
const anillos = [
  {
    id: "energyPieChart",
    titulo: "Renovables frente a no renovables",
    centro: pct(PCT_RENOVABLE),
    sub: "renovable",
    aria: `Gráfica de anillo: ${pct(PCT_RENOVABLE)} de la generación es renovable y ${pct(PCT_NO_RENOVABLE)} no renovable`,
    partes: [
      { nombre: "Renovable", valor: PCT_RENOVABLE, token: "accent" },
      { nombre: "No renovable", valor: PCT_NO_RENOVABLE, token: "muted" },
    ],
  },
  {
    id: "renewablePieChart",
    titulo: "Reparto de la generación renovable",
    centro: pct(RENOVABLES[0].pct_reno),
    sub: "es eólica",
    aria: "Gráfica de anillo del reparto de la generación renovable por tecnología; los valores están en la leyenda",
    partes: RENOVABLES.map((r) => ({ nombre: r.tecnologia, valor: r.pct_reno, token: r.token })),
  },
];
---

<div class="mix">
  <div class="mix-dos">
    {anillos.map((a) => (
      <figure class="a-card mix-card">
        <figcaption class="font-display mix-tit">{a.titulo}</figcaption>
        <div class="mix-fila">
          <div class="mix-anillo">
            <canvas id={a.id} role="img" aria-label={a.aria} data-anillo={JSON.stringify(a.partes)}></canvas>
            <div class="mix-centro" aria-hidden="true">
              <span class="num font-display">{a.centro}</span>
              <small>{a.sub}</small>
            </div>
          </div>
          <ul class="mix-leyenda">
            {a.partes.map((p) => (
              <li>
                <i style={`background: var(--${p.token})`}></i>
                <span>{p.nombre}</span>
                <b class="num">{pct(p.valor)}</b>
              </li>
            ))}
          </ul>
        </div>
      </figure>
    ))}
  </div>

  <details class="a-tabla">
    <summary>Ver los datos en tabla</summary>
    <div class="a-tabla-wrap">
      <table>
        <caption class="sr-only">Porcentaje de la generación por tecnología</caption>
        <thead><tr><th scope="col">Tecnología</th><th scope="col">% sobre la generación total</th><th scope="col">% dentro de las renovables</th></tr></thead>
        <tbody>
          {RENOVABLES.map((r) => (
            <tr><th scope="row" style="font-weight:400;color:var(--ink)">{r.tecnologia}</th><td>{pct(r.pct_total)}</td><td>{pct(r.pct_reno)}</td></tr>
          ))}
          <tr><th scope="row" style="font-weight:400;color:var(--ink)">No renovable</th><td>{pct(PCT_NO_RENOVABLE)}</td><td>—</td></tr>
          <tr><th scope="row" style="color:var(--ink)">Total</th><td>100,00 %</td><td>100,00 %</td></tr>
        </tbody>
      </table>
    </div>
  </details>

  <div class="mix-nota">
    <p class="mix-nota-tit">En pocas palabras</p>
    <p>La eólica es la renovable más importante: aporta el 40 % de la electricidad renovable. Por eso es la que intentamos predecir.</p>
    <p class="mix-fuente">Periodo: {mix.periodo}. Fuente: {mix.fuente}</p>
  </div>
</div>

<style>
  .mix { display: flex; flex-direction: column; gap: 20px; }
  .mix-dos { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(380px, 100%), 1fr)); gap: 20px; }
  .mix-card { min-width: 0; display: flex; flex-direction: column; gap: 18px; margin: 0; }
  .mix-tit { font-size: 18px; font-weight: 600; }
  .mix-fila { display: flex; flex-wrap: wrap; gap: 24px; align-items: center; }
  .mix-anillo { position: relative; width: 220px; height: 220px; flex: none; }
  .mix-centro { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; pointer-events: none; }
  .mix-centro span { font-size: 32px; font-weight: 700; letter-spacing: -0.03em; color: var(--ink); line-height: 1.1; }
  .mix-centro small { font-size: 12px; color: var(--muted); }
  .mix-leyenda { flex: 1 1 200px; min-width: 0; margin: 0; padding: 0; list-style: none; }
  .mix-leyenda li { display: grid; grid-template-columns: 12px 1fr auto; gap: 10px; align-items: center; padding: 9px 0; border-top: 1px solid var(--line); font-size: 14px; color: var(--ink); }
  .mix-leyenda i { width: 12px; height: 12px; border-radius: 3px; }
  .mix-leyenda b { font-weight: 600; }
  .mix-nota { background: var(--surface2); border: 1px solid var(--line); border-radius: 16px; padding: 18px 22px; display: flex; flex-direction: column; gap: 6px; max-width: 900px; }
  .mix-nota p { margin: 0; font-size: 15px; color: var(--ink); }
  .mix-nota .mix-nota-tit { font-size: 12px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); }
  .mix-nota .mix-fuente { font-size: 13px; color: var(--muted); }
</style>

<script>
  import { Chart, registerables } from "chart.js";
  import "../../utils/charts-tema";
  import { token } from "../../utils/tema";

  Chart.register(...registerables);

  type Parte = { nombre: string; valor: number; token: string };

  document.querySelectorAll<HTMLCanvasElement>("canvas[data-anillo]").forEach((canvas) => {
    const partes: Parte[] = JSON.parse(canvas.dataset.anillo!);
    const colores = () => partes.map((p) => token(p.token));
    const chart = new Chart(canvas, {
      type: "doughnut",
      data: {
        labels: partes.map((p) => p.nombre),
        datasets: [{ data: partes.map((p) => p.valor), backgroundColor: colores(), borderWidth: 0, hoverOffset: 6 }],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        cutout: "68%",
        animation: false,
        plugins: {
          legend: { display: false },
          tooltip: { callbacks: { label: (c) => ` ${c.label}: ${Number(c.raw).toLocaleString("es-ES", { minimumFractionDigits: 2 })} %` } },
        },
      },
    });
    // Los colores salen de los tokens: se recalculan al cambiar de tema.
    window.addEventListener("aero-tema", () => {
      chart.data.datasets[0].backgroundColor = colores();
      chart.update("none");
    });
  });
</script>
