---
// Real frente a las predicciones de cada modelo con 16 y con 19 variables.
// Las métricas de cada versión se muestran con su protocolo y no se restan (D-9-8).
import data from "../../data/model-predictions.json";
import { formatMetric, formatNumber, formatDateEs } from "../../utils/evolution.mjs";

const VIGENTE = "Linear Regression";

const p16 = data.protocolo16;
const p19 = data.protocolo19;
const window16 = `16 variables · test del ${formatDateEs(p16.desde)} al ${formatDateEs(p16.hasta)} (46 semanas)`;
const window19 = `19 variables · test del ${formatDateEs(p19.desde)} al ${formatDateEs(p19.hasta)} (${p19.dias} días)`;
const RECHAZADO = "LightGBM";

const labels = data.semanas.map((iso) => {
  const [y, m, d] = iso.split("-");
  return `${Number(d)}/${Number(m)}/${y.slice(2)}`;
});

const toGWh = (v: number | null) => (v === null ? null : Math.round(v / 100) / 10);

const models = data.modelos.map((m, i) => ({
  id: `modelChart${i}`,
  nombre: m.modelo,
  vigente: m.modelo === VIGENTE,
  rechazado: m.modelo === RECHAZADO,
  m16: m.metricas16,
  m19: m.metricas19,
  series: {
    labels,
    real: data.real.map(toGWh),
    pred16: m.pred16.map(toGWh),
    pred19: m.pred19.map(toGWh),
  },
}));

const badge = "text-xs px-2 py-0.5 rounded-full whitespace-nowrap";
---

<div class="space-y-6">
  <div class="text-sm text-gray-600 dark:text-gray-400 space-y-1">
    <p>
      Media semanal de la generación eólica real (negro) frente a la predicción de cada modelo con
      16 variables (naranja) y con 19 variables (azul). Valores en GWh.
    </p>
    <p class="text-xs">
      Las métricas de cada versión se midieron en periodos distintos, así que se muestran juntas pero no se restan.
      Las de 19 variables proceden de la última ejecución del notebook, con un día más de datos que la evaluación
      del modelo en producción (paso 6); por eso difieren ligeramente.
    </p>
    <p class="text-xs">Fuentes: {data.fuente.pred19} {data.fuente.pred16} {data.fuente.real}</p>
  </div>

  {models.map((m) => (
    <figure class={`bg-white dark:bg-gray-900 rounded-xl p-4 shadow border ${m.vigente ? "border-green-500" : "border-gray-100 dark:border-gray-700"}`}>
      <figcaption class="mb-3 space-y-2">
        <div class="flex flex-wrap items-center gap-2">
          <span class="font-semibold text-gray-800 dark:text-white text-base">{m.nombre}</span>
          {m.vigente && <span class={`${badge} bg-green-100 text-green-800 dark:bg-green-900/40 dark:text-green-200 font-semibold`}>Modelo vigente</span>}
          {m.rechazado && <span class={`${badge} bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-200 font-semibold`}>Rechazado: mejora en 1 de 4 años</span>}
        </div>
        <dl class="grid gap-2 sm:grid-cols-2 text-xs">
          <div class="rounded-lg bg-orange-50 dark:bg-orange-900/20 p-2">
            <dt class="font-semibold text-orange-800 dark:text-orange-200">{window16}</dt>
            <dd class="text-gray-700 dark:text-gray-300">
              {m.m16
                ? <>RMSE {formatMetric(m.m16.rmse, "rmse")} · R² {formatMetric(m.m16.r2, "r2")} · MAPE {formatMetric(m.m16.mape, "mape")}</>
                : "no disponible"}
            </dd>
          </div>
          <div class="rounded-lg bg-blue-50 dark:bg-blue-900/20 p-2">
            <dt class="font-semibold text-blue-800 dark:text-blue-200">{window19}</dt>
            <dd class="text-gray-700 dark:text-gray-300">
              RMSE {formatMetric(m.m19.rmse, "rmse")} · MAE {formatMetric(m.m19.mae, "mae")} ·
              R² {formatMetric(m.m19.r2, "r2")} · MAPE {formatMetric(m.m19.mape, "mape")} ·
              Acierto por tramos {formatNumber(m.m19.accuracy, 1)} %
            </dd>
          </div>
        </dl>
      </figcaption>
      <div style="position:relative;height:220px;">
        <canvas
          id={m.id}
          data-series={JSON.stringify(m.series)}
          role="img"
          aria-label={`${m.nombre}: generación real y predicciones semanales con 16 y 19 variables`}
        ></canvas>
      </div>
    </figure>
  ))}
</div>

<script>
  import { Chart, registerables } from "chart.js";

  Chart.register(...registerables);

  type Series = { labels: string[]; real: (number | null)[]; pred16: (number | null)[]; pred19: (number | null)[] };

  document.querySelectorAll<HTMLCanvasElement>("canvas[data-series]").forEach((canvas) => {
    const s: Series = JSON.parse(canvas.dataset.series!);
    new Chart(canvas, {
      type: "line",
      data: {
        labels: s.labels,
        datasets: [
          { label: "Real", data: s.real, borderColor: "#374151", borderWidth: 1.8, pointRadius: 0, tension: 0.3 },
          { label: "16 variables", data: s.pred16, borderColor: "tomato", borderWidth: 1.2, pointRadius: 0, tension: 0.3 },
          { label: "19 variables", data: s.pred19, borderColor: "#2563EB", borderWidth: 1.4, pointRadius: 0, tension: 0.3 },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: false,
        interaction: { mode: "index", intersect: false },
        plugins: {
          legend: { position: "top", labels: { boxWidth: 12, font: { size: 11 }, color: "#9CA3AF" } },
          tooltip: {
            callbacks: {
              label: (ctx) => (ctx.parsed.y === null ? "" : `${ctx.dataset.label}: ${Number(ctx.parsed.y).toLocaleString("es-ES")} GWh`),
            },
          },
        },
        scales: {
          x: { ticks: { font: { size: 9 }, color: "#9CA3AF", maxRotation: 0, autoSkip: true, maxTicksLimit: 10 }, grid: { display: false } },
          y: { title: { display: true, text: "GWh/día (media semanal)", font: { size: 10 }, color: "#9CA3AF" }, ticks: { font: { size: 9 }, color: "#9CA3AF" } },
        },
      },
    });
  });
</script>
