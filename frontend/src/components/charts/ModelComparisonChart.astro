---
// Real frente a las predicciones de cada modelo con 16 y con 19 variables.
// Las métricas de cada versión se muestran con su protocolo y no se restan (D-9-8).
import data from "../../data/model-predictions.json";
import { formatMetric, formatNumber, formatDateEs } from "../../utils/evolution.mjs";

const VIGENTE = "Linear Regression";

// Las dos variantes comparten ventana (spec 011): el test lo exige, así que se declara una sola vez.
const p = data.protocolo19;
const window16 = "16 variables";
const window19 = "19 variables";
const RECHAZADO = "LightGBM";

const labels = data.semanas.map((iso) => {
  const [y, m, d] = iso.split("-");
  return `${Number(d)}/${Number(m)}/${y.slice(2)}`;
});

const toGWh = (v: number | null) => (v === null ? null : Math.round(v / 100) / 10);

const models = data.modelos.map((m, i) => ({
  id: `modelChart${i}`,
  nombre: m.modelo,
  vigente: m.modelo === VIGENTE,
  rechazado: m.modelo === RECHAZADO,
  m16: m.metricas16,
  m19: m.metricas19,
  series: {
    labels,
    real: data.real.map(toGWh),
    pred16: m.pred16.map(toGWh),
    pred19: m.pred19.map(toGWh),
  },
}));

const badge = "text-xs px-2 py-0.5 rounded-full whitespace-nowrap";
---

<div class="space-y-6">
  <div class="text-sm text-muted space-y-1" style="max-width: 80ch">
    <p>
      Media semanal (lunes a domingo, etiquetada por su domingo) de la generación eólica real (línea continua) frente a la
      predicción de cada modelo con 16 variables (naranja) y con 19 variables (azul). Valores en GWh.
    </p>
    <p class="text-xs">
      Las dos versiones se evalúan en la misma ventana: del {formatDateEs(p.desde)} al {formatDateEs(p.hasta)}
      ({formatNumber(p.dias, 0)} días, {formatNumber(p.semanas, 0)} semanas). Cada modelo se entrenó solo con los
      {formatNumber(p.dias_entrenamiento, 0)} días anteriores (hasta el {formatDateEs(p.entrenamiento_hasta)}) y predice
      toda la ventana sin reentrenar, así que sus cifras sí se pueden comparar entre 16 y 19 variables. No son
      comparables con la del modelo en producción (paso 6, otra ventana) ni con la línea base histórica de 16 variables,
      medida con el pipeline anterior. SARIMAX solo usa viento y racha, por eso sus dos líneas coinciden.
    </p>
    <p class="text-xs">Fuentes: {data.fuente.pred19} {data.fuente.pred16} {data.fuente.real}</p>
  </div>

  {models.map((m) => (
    <figure class="a-card" style={m.vigente ? "border-color: var(--accent)" : ""}>
      <figcaption class="mb-3 space-y-2">
        <div class="flex flex-wrap items-center gap-2">
          <span class="font-display font-semibold text-ink text-lg">{m.nombre}</span>
          {m.vigente && <span class={`${badge} font-semibold" style="background: var(--accent); color: var(--accentInk)`}>Modelo vigente</span>}
          {m.rechazado && <span class={`${badge} font-semibold" style="border: 1px solid var(--warm); color: var(--warm)`}>Rechazado: mejora en 1 de 4 años</span>}
        </div>
        <dl class="grid gap-2 sm:grid-cols-2 text-xs">
          <div class="rounded-lg p-3" style="border: 1px solid var(--coral)">
            <dt class="font-semibold" style="color: var(--coral)">{window16}</dt>
            <dd class="text-ink">
              RMSE {formatMetric(m.m16.rmse, "rmse")} · MAE {formatMetric(m.m16.mae, "mae")} ·
              R² {formatMetric(m.m16.r2, "r2")} · MAPE {formatMetric(m.m16.mape, "mape")} ·
              Acierto por tramos {formatNumber(m.m16.accuracy, 1)} %
            </dd>
          </div>
          <div class="rounded-lg p-3" style="border: 1px solid var(--sky)">
            <dt class="font-semibold" style="color: var(--sky)">{window19}</dt>
            <dd class="text-ink">
              RMSE {formatMetric(m.m19.rmse, "rmse")} · MAE {formatMetric(m.m19.mae, "mae")} ·
              R² {formatMetric(m.m19.r2, "r2")} · MAPE {formatMetric(m.m19.mape, "mape")} ·
              Acierto por tramos {formatNumber(m.m19.accuracy, 1)} %
            </dd>
          </div>
        </dl>
      </figcaption>
      <div style="position:relative;height:clamp(260px, 42vw, 380px);">
        <canvas
          id={m.id}
          data-series={JSON.stringify(m.series)}
          role="img"
          aria-label={`${m.nombre}: generación real y predicciones semanales con 16 y 19 variables`}
        ></canvas>
      </div>
      <details class="a-tabla">
        <summary>Ver los datos en tabla</summary>
        <div class="a-tabla-wrap">
          <table>
            <caption class="sr-only">{m.nombre}: GWh por semana</caption>
            <thead><tr><th scope="col">Semana</th><th scope="col">Real</th><th scope="col">16 variables</th><th scope="col">19 variables</th></tr></thead>
            <tbody>
              {m.series.labels.map((l, i) => (
                <tr><th scope="row" style="font-weight:400;color:var(--ink)">{l}</th><td>{formatNumber(m.series.real[i] ?? 0, 1)}</td><td>{formatNumber(m.series.pred16[i] ?? 0, 1)}</td><td>{formatNumber(m.series.pred19[i] ?? 0, 1)}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
    </figure>
  ))}
</div>

<script>
  import { Chart, registerables } from "chart.js";
  import "../../utils/charts-tema";

  Chart.register(...registerables);

  type Series = { labels: string[]; real: (number | null)[]; pred16: (number | null)[]; pred19: (number | null)[] };

  document.querySelectorAll<HTMLCanvasElement>("canvas[data-series]").forEach((canvas) => {
    const s: Series = JSON.parse(canvas.dataset.series!);
    new Chart(canvas, {
      type: "line",
      data: {
        labels: s.labels,
        datasets: [
          { label: "Real", tokenColor: "ink", data: s.real, borderColor: "#374151", borderWidth: 2.2, pointRadius: 0, tension: 0.3 },
          { label: "16 variables", tokenColor: "coral", data: s.pred16, borderColor: "tomato", borderWidth: 2, pointRadius: 0, tension: 0.3 },
          { label: "19 variables", tokenColor: "sky", data: s.pred19, borderColor: "#2563EB", borderWidth: 2, pointRadius: 0, tension: 0.3 },
        ] as any[],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: false,
        interaction: { mode: "index", intersect: false },
        plugins: {
          legend: { position: "top", labels: { boxWidth: 12, font: { size: 11 }, color: "#9CA3AF" } },
          tooltip: {
            callbacks: {
              label: (ctx) => (ctx.parsed.y === null ? "" : `${ctx.dataset.label}: ${Number(ctx.parsed.y).toLocaleString("es-ES")} GWh`),
            },
          },
        },
        scales: {
          x: { ticks: { font: { size: 9 }, color: "#9CA3AF", maxRotation: 0, autoSkip: true, maxTicksLimit: 10 }, grid: { display: false } },
          y: { title: { display: true, text: "GWh/día (media semanal)", font: { size: 10 }, color: "#9CA3AF" }, ticks: { font: { size: 9 }, color: "#9CA3AF" } },
        },
      },
    });
  });
</script>
