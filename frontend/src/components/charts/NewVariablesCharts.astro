---
// Las nuevas variables frente a la producción eólica (specs 013 y 016): un punto por día.
import data from "../../data/nuevas-variables.json";
import DispersionDiaria from "./DispersionDiaria.astro";
import Nota from "../proceso/Nota.astro";
import { formatNumber } from "../../utils/evolution.mjs";

const dias = `${formatNumber(data.periodo.dias, 0)} días reales`;
const r = data.correlacion;
const tres = (v: number) => formatNumber(Math.abs(v), 3).padEnd(5, "0");
const ejeY = { y: "Producción", yUnidad: "GWh", yDecimales: 0 };
---

<div class="nv">
  <div class="nv-cab">
    <h4 class="font-display">El sol y la temperatura de ayer: una relación inversa</h4>
    <p>Al contrario que el viento, cuanto más sol y más calor hubo el día anterior, menos producción eólica suele haber hoy. La nube de puntos cae hacia la derecha.</p>
  </div>
  <div class="nv-dos">
    <DispersionDiaria
      id="nvSol" titulo="Sol de ayer frente a producción de hoy" x={data.sol_lag1} y={data.eolica_gwh} fechas={data.fecha}
      eje={{ x: "Sol de ayer", xUnidad: "h", xDecimales: 1, ...ejeY }} rango={{ x: [0, 15], y: [0, 500] }} token="warm" linea="ajuste"
      pie={`${dias}. Eje horizontal: horas de sol del día anterior; eje vertical: producción eólica del día, en GWh. La línea discontinua es la recta que mejor se ajusta a la nube: baja.`}
      tabla={{ cabecera: "Sol del día anterior (h)", mediaCabecera: "Producción media (GWh)", bordes: [0, 3, 6, 9, 12, 15] }}
    />
    <DispersionDiaria
      id="nvTmed" titulo="Temperatura de ayer frente a producción de hoy" x={data.tmed_lag1} y={data.eolica_gwh} fechas={data.fecha}
      eje={{ x: "Temperatura de ayer", xUnidad: "°C", xDecimales: 1, ...ejeY }} rango={{ x: [0, 35], y: [0, 500] }} token="coral" linea="ajuste"
      pie={`${dias}. Eje horizontal: temperatura media del día anterior, en °C; eje vertical: producción eólica del día, en GWh. La recta también baja.`}
      tabla={{ cabecera: "Temperatura del día anterior (°C)", mediaCabecera: "Producción media (GWh)", bordes: [5, 10, 15, 20, 25, 30, 35] }}
    />
  </div>
  <Nota titulo="Qué nos dicen">
    La relación es inversa y moderada: r = −{tres(r.sol_lag1)} con el sol y r = −{tres(r.tmed_lag1)} con la temperatura. La correlación no demuestra causa, pero aporta información que el viento no da. Coeficientes de Pearson sobre {formatNumber(data.periodo.dias, 0)} días.
  </Nota>

  <div class="nv-cab nv-sep">
    <h4 class="font-display">La previsión de REE: casi una diagonal</h4>
    <p>REE publica cada día cuánta electricidad eólica espera generar. Es la variable nueva más fuerte: sus puntos se pegan a la diagonal.</p>
  </div>
  <div class="nv-uno">
    <DispersionDiaria
      id="nvRee" titulo="Previsión de REE frente a producción real" x={data.eolica_prev_gwh} y={data.eolica_gwh} fechas={data.fecha}
      eje={{ x: "Previsión de REE", xUnidad: "GWh", xDecimales: 0, y: "Producción real", yUnidad: "GWh", yDecimales: 0 }} rango={{ x: [0, 500], y: [0, 500] }} token="accent" linea="diagonal"
      pie={`${dias}. Eje horizontal: lo que REE previó generar con eólica; eje vertical: lo que se generó, ambos en GWh. La línea discontinua es la diagonal: si la previsión fuera perfecta, todos los puntos caerían sobre ella.`}
      tabla={{ cabecera: "Previsión de REE (GWh)", mediaCabecera: "Producción real media (GWh)", bordes: [0, 100, 200, 300, 400, 500] }}
    />
  </div>
  <Nota titulo="Qué nos dice">
    r = +{tres(r.eolica_prev)}: la previsión de REE es la variable con más relación con la producción, por encima del viento y del dato del día anterior. Por eso entró en el modelo, que pasó a usar 19 variables.
  </Nota>
</div>

<style>
  .nv { display: flex; flex-direction: column; gap: 20px; }
  .nv-cab { display: flex; flex-direction: column; gap: 14px; }
  .nv-cab h4 { margin: 0; font-size: 20px; font-weight: 600; }
  .nv-cab p { margin: 0; max-width: 62ch; color: var(--muted); text-wrap: pretty; }
  .nv-sep { margin-top: 12px; }
  /* Dos por fila como en el lienzo también con la columna de 700-800 px de la web */
  .nv-dos { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr)); gap: 20px; }
  .nv-uno { max-width: 640px; }
</style>
