---
// Importancia de las 19 variables del modelo vigente, desde datos congelados (CA-5.5).
import series from "../../data/reference-series.json";
import { formatNumber } from "../../utils/evolution.mjs";

const { importancia } = series;
const rows = importancia.valores.map((v) => ({
  label: v.descripcion,
  value: Math.round(v.importance * 1000) / 10,
}));
---

<figure class="bg-white dark:bg-gray-800 rounded-xl p-4 shadow-md">
  <figcaption class="mb-3">
    <span class="block text-base font-semibold text-gray-800 dark:text-white">Peso de cada variable en el modelo vigente</span>
    <span class="block text-xs text-gray-500 dark:text-gray-400 mt-1">{importancia.periodo}. {importancia.fuente}</span>
  </figcaption>
  <div style="position:relative;height:520px;">
    <canvas id="featureImportanceChart" role="img" aria-label="Gráfica de barras con el peso de las 19 variables" data-rows={JSON.stringify(rows)}></canvas>
  </div>
  <ul class="sr-only">
    {rows.map((r) => <li>{r.label}: {formatNumber(r.value, 1)} %</li>)}
  </ul>
</figure>

<script>
  import { Chart, registerables } from "chart.js";

  Chart.register(...registerables);

  const canvas = document.getElementById("featureImportanceChart") as HTMLCanvasElement | null;
  if (canvas?.dataset.rows) {
    const rows: { label: string; value: number }[] = JSON.parse(canvas.dataset.rows);
    new Chart(canvas, {
      type: "bar",
      data: {
        labels: rows.map((r) => r.label),
        datasets: [{ label: "Peso (%)", data: rows.map((r) => r.value), backgroundColor: "#2196F3" }],
      },
      options: {
        indexAxis: "y",
        responsive: true,
        maintainAspectRatio: false,
        animation: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: { label: (ctx) => `Peso: ${Number(ctx.parsed.x).toLocaleString("es-ES")} %` },
          },
        },
        scales: {
          x: {
            beginAtZero: true,
            title: { display: true, text: "Peso relativo (%)", color: "#9CA3AF" },
            ticks: { color: "#9CA3AF" },
          },
          y: {
            ticks: {
              color: "#9CA3AF",
              font: { size: 10 },
              // Etiquetas largas cortadas para que quepan en móvil.
              callback: function (value) {
                const text = String(this.getLabelForValue(Number(value)));
                return text.length > 38 ? text.slice(0, 36) + "…" : text;
              },
            },
          },
        },
      },
    });
  }
</script>
