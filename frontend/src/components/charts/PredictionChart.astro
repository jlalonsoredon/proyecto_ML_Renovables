---
// Real de los últimos 30 días completos + previsión publicada en el snapshot (CA-5.3).
// Aspecto y controles del lienzo de diseño (spec 017): botones de serie, lectura del día con pasos y tabla.
import snapshot from "../../data/forecast-snapshot.json";
import { snapshotStatus, todayInMadrid } from "../../utils/forecast.mjs";
import Pasos from "../proceso/Pasos.astro";

const buildStatus = snapshotStatus(snapshot, todayInMadrid());
const series = [
  { nombre: "Real (GWh)", forma: "linea", token: "ink" },
  { nombre: "Modelo (GWh)", forma: "discontinua", token: "accent" },
  { nombre: "Predicción de mañana", forma: "rombo", token: "accent" },
  { nombre: "Viento medio (m/s)", forma: "barra", token: "sky" },
  { nombre: "Racha (m/s)", forma: "barra", token: "warm" },
];
---

<div class="pc" id="pc-raiz">
  <div class="ctl-grupo" role="group" aria-label="Series visibles">
    {series.map((s, i) => (
      <button type="button" class="ctl-btn" aria-pressed="true" data-pc-serie={i}>
        {s.forma === "linea" && <span class="pc-m pc-linea" style={`border-top-color: var(--${s.token})`}></span>}
        {s.forma === "discontinua" && <span class="pc-m pc-linea pc-disc" style={`border-top-color: var(--${s.token})`}></span>}
        {s.forma === "rombo" && <span class="pc-m pc-rombo" style={`background: var(--${s.token})`}></span>}
        {s.forma === "barra" && <span class="pc-m pc-barra" style={`background: var(--${s.token})`}></span>}
        {s.nombre}
      </button>
    ))}
  </div>
  <div class="ctl-lectura"><p class="num" data-lectura aria-live="polite"></p><Pasos que="Día" /></div>
  <div id="pc-error" class="pc-error" role="alert" hidden></div>
  <div id="pc-wrap" class="ctl-lienzo pc-lienzo">
    <canvas id="predictionChart" role="img" aria-label="Producción eólica real y prevista de los últimos 30 días completos, con viento medio y rachas"></canvas>
  </div>
  <p class="a-p ctl-ayuda"><span id="pc-subtitle"></span> Pulsa una serie para ocultarla o mostrarla.</p>
  <p id="pc-note" class="a-p ctl-ayuda" role="status" aria-live="polite">{buildStatus.mensaje}</p>
  <details class="a-tabla">
    <summary>Ver los datos en tabla</summary>
    <div class="a-tabla-wrap">
      <table>
        <caption class="sr-only">Generación eólica real y prevista por día, con viento y racha</caption>
        <thead><tr><th scope="col">Día</th><th scope="col">Real (GWh)</th><th scope="col">Modelo (GWh)</th><th scope="col">Viento medio (m/s)</th><th scope="col">Racha (m/s)</th></tr></thead>
        <tbody id="pc-table"></tbody>
      </table>
    </div>
  </details>
  <noscript>
    <p class="a-p">Esta gráfica necesita JavaScript para dibujarse. La nota de arriba indica el estado de la previsión publicada.</p>
  </noscript>
</div>

<style>
  .pc { display: flex; flex-direction: column; gap: 16px; min-width: 0; }
  .pc-lienzo { height: clamp(280px, 40vw, 420px); }
  .pc-error { text-align: center; padding: 40px 0; color: var(--coral); font-size: 14px; }
  .pc-m { flex: none; }
  .pc-linea { width: 18px; height: 0; border-top: 3px solid; }
  .pc-disc { border-top-style: dashed; }
  .pc-rombo { width: 10px; height: 10px; transform: rotate(45deg); }
  .pc-barra { width: 10px; height: 10px; border-radius: 2px; opacity: 0.7; }
</style>

<script>
  import { Chart, registerables } from "chart.js";
  import "../../utils/charts-tema";
  import { token } from "../../utils/tema";
  import { conectarPasos } from "../../utils/chart-pasos";
  import snapshot from "../../data/forecast-snapshot.json";
  import { selectCompleteWindow, formatDateEs, formatNumber } from "../../utils/evolution.mjs";
  import { FORECAST_STATE, snapshotStatus, todayInMadrid } from "../../utils/forecast.mjs";

  Chart.register(...registerables);

  type Day = { fecha: string; eolica: number | null };
  type ChartData = {
    fechas_hist?: string[];
    real_gwh?: (number | null)[];
    pred_gwh?: (number | null)[];
    vel_ms?: (number | null)[];
    racha_ms?: (number | null)[];
    vel_origen?: (string | null)[];
    racha_origen?: (string | null)[];
    manana?: { fecha?: string; pred_gwh?: number | null; velmedia?: number | null; racha?: number | null; modelo?: string };
  };

  const WINDOW_DAYS = 30;
  const MESES = ["ene", "feb", "mar", "abr", "may", "jun", "jul", "ago", "sep", "oct", "nov", "dic"];
  const raiz = document.getElementById("pc-raiz")!;
  const errorBox = document.getElementById("pc-error")!;
  const wrap = document.getElementById("pc-wrap")!;
  const subtitle = document.getElementById("pc-subtitle")!;
  const note = document.getElementById("pc-note")!;

  const isNum = (v: unknown): v is number => typeof v === "number" && Number.isFinite(v);
  const shortDate = (iso: string) => {
    const [, m, d] = iso.split("-");
    return `${Number(d)}/${Number(m)}`;
  };
  const longDate = (iso: string) => `${Number(iso.slice(8, 10))} ${MESES[Number(iso.slice(5, 7)) - 1]} ${iso.slice(0, 4)}`;
  const uno = (v: number) => new Intl.NumberFormat("es-ES", { minimumFractionDigits: 1, maximumFractionDigits: 1, useGrouping: "always" } as Intl.NumberFormatOptions).format(v);
  // Barras de viento: color del token con transparencia; más tenue si el dato es una previsión de AEMET.
  const alfa = (nombre: string, a: string) => `${token(nombre)}${a}`;

  function showError(message: string) {
    wrap.hidden = true;
    errorBox.textContent = message;
    errorBox.hidden = false;
  }

  /** Mapa fecha → valor a partir de dos listas paralelas. */
  function byDate<T>(dates: string[] = [], values: (T | null)[] = []) {
    const map = new Map<string, T | null>();
    dates.forEach((d, i) => map.set(d, values[i] ?? null));
    return map;
  }

  function init() {
    const chart = (snapshot as { grafico?: ChartData }).grafico ?? null;
    const status = snapshotStatus(snapshot, todayInMadrid());

    // Serie real: el histórico trae 45 días para poder retroceder hasta 30 completos.
    const history = (snapshot as { historico?: Day[] }).historico ?? [];
    const series: Day[] = Array.isArray(history) ? history.map((d) => ({ fecha: d.fecha, eolica: d.eolica })) : [];
    const { days, discarded } = selectCompleteWindow(series, WINDOW_DAYS);
    if (days.length === 0) {
      showError("No hay datos de generación en la previsión publicada.");
      return;
    }

    const preds = byDate(chart?.fechas_hist, chart?.pred_gwh);
    const vel = byDate(chart?.fechas_hist, chart?.vel_ms);
    const racha = byDate(chart?.fechas_hist, chart?.racha_ms);
    const velOrigen = byDate(chart?.fechas_hist, chart?.vel_origen);
    const rachaOrigen = byDate(chart?.fechas_hist, chart?.racha_origen);

    const fechas = days.map((d) => d.fecha);
    const labels = days.map((d) => shortDate(d.fecha));
    const real = days.map((d) => (isNum(d.eolica) ? Math.round(d.eolica / 100) / 10 : null));
    const predHist = days.map((d) => preds.get(d.fecha) ?? null);
    const velData = days.map((d) => vel.get(d.fecha) ?? null);
    const rachaData = days.map((d) => racha.get(d.fecha) ?? null);

    // Sin origen declarado (snapshots antiguos) el viento solo puede ser observado.
    const originOf = (map: Map<string, string | null>, fecha: string, value: number | null) => {
      const declared = map.get(fecha);
      if (declared === "prevision" || declared === "observacion") return declared;
      return isNum(value) ? "observacion" : null;
    };
    const velOrig = days.map((d, i) => originOf(velOrigen, d.fecha, velData[i]));
    const rachaOrig = days.map((d, i) => originOf(rachaOrigen, d.fecha, rachaData[i]));
    const rellenos = velOrig.filter((origen) => origen === "prevision").length;

    // Predicción publicada: se muestra con su estado, nunca se rellena (D-9-18).
    const manana = chart?.manana;
    const hasTomorrow = status.estado !== FORECAST_STATE.UNAVAILABLE && isNum(manana?.pred_gwh);
    const tomorrowGWh = hasTomorrow ? Math.round((manana!.pred_gwh as number) * 10) / 10 : null;
    let sufijo = "";
    if (hasTomorrow) {
      sufijo = status.estado === FORECAST_STATE.STALE ? "caducada"
        : status.estado === FORECAST_STATE.PENDING ? "hoy" : "mañana";
      fechas.push(status.objetivo as string);
      labels.push(`${shortDate(status.objetivo as string)} · ${sufijo}`);
      real.push(null);
      predHist.push(tomorrowGWh);
      const velManana = isNum(manana?.velmedia) ? (manana!.velmedia as number) : null;
      const rachaManana = isNum(manana?.racha) ? (manana!.racha as number) : null;
      velData.push(velManana);
      rachaData.push(rachaManana);
      velOrig.push(velManana === null ? null : "prevision");
      rachaOrig.push(rachaManana === null ? null : "prevision");
    }
    const ultimo = labels.length - 1;
    const tomorrowPoint = labels.map((_, i) => (hasTomorrow && i === ultimo ? tomorrowGWh : null));
    // El modelo de los días pasados no se une con la cifra de mañana: esa va en su rombo.
    const predLinea = predHist.map((v, i) => (hasTomorrow && i === ultimo ? null : v));

    subtitle.textContent = `Del ${formatDateEs(days[0].fecha)} al ${formatDateEs(days.at(-1)!.fecha)}.`;
    const notes = [status.mensaje];
    if (days.length < WINDOW_DAYS) notes.push(`Solo hay ${days.length} días completos disponibles.`);
    if (discarded > 0) notes.push(`Se ${discarded === 1 ? "omite 1 día incompleto" : `omiten ${discarded} días incompletos`} al final de la serie.`);
    if (hasTomorrow) notes.push(`Producción prevista: ${formatNumber(tomorrowGWh as number, 1)} GWh.`);
    if (rellenos > 0) {
      notes.push(
        rellenos === 1
          ? "Se rellena 1 día con la previsión de AEMET al no haber observación (barra más tenue)."
          : `Se rellenan ${rellenos} días con la previsión de AEMET al no haber observación (barras más tenues).`,
      );
    }
    note.textContent = notes.join(" ");

    const fmt = (v: number | null) => (isNum(v) ? uno(v) : "—");
    const tabla = document.getElementById("pc-table");
    if (tabla) {
      tabla.innerHTML = labels
        .map((l, i) => `<tr><th scope="row" style="font-weight:400;color:var(--ink)">${l}</th><td>${fmt(real[i])}</td><td>${fmt(predHist[i])}</td><td>${fmt(velData[i])}</td><td>${fmt(rachaData[i])}</td></tr>`)
        .join("");
    }

    const relleno = (origenes: (string | null)[], nombre: string, observado: string, previsto: string) =>
      origenes.map((o) => alfa(nombre, o === "prevision" ? previsto : observado));
    const borde = (origenes: (string | null)[], nombre: string) => origenes.map((o) => (o === "prevision" ? token(nombre) : "rgba(0,0,0,0)"));

    const datasets: any[] = [
      { label: "Real", tokenColor: "ink", type: "line", data: real, borderColor: "#888", borderWidth: 2.4, pointRadius: 0, pointHoverRadius: 5, tension: 0.3, yAxisID: "yGen", order: 1 },
      { label: "Modelo", tokenColor: "accent", type: "line", data: predLinea, borderColor: "#888", borderDash: [6, 5], borderWidth: 2.4, pointRadius: 0, pointHoverRadius: 5, tension: 0.3, spanGaps: true, yAxisID: "yGen", order: 1 },
      { label: "Predicción de mañana", type: "line", data: tomorrowPoint, tokenBg: "accent", backgroundColor: "#888", borderColor: token("bg"), borderWidth: 3, pointRadius: 11, pointHoverRadius: 12, pointStyle: "rectRot", showLine: false, yAxisID: "yGen", order: 0 },
      { label: "Viento medio", type: "bar", data: velData, backgroundColor: relleno(velOrig, "sky", "73", "29"), borderColor: borde(velOrig, "sky"), borderWidth: 1, borderSkipped: false, borderRadius: 2, yAxisID: "yWind", order: 3 },
      { label: "Racha", type: "bar", data: rachaData, backgroundColor: relleno(rachaOrig, "warm", "80", "29"), borderColor: borde(rachaOrig, "warm"), borderWidth: 1, borderSkipped: false, borderRadius: 2, yAxisID: "yWind", order: 3 },
    ];
    const unidades = [" GWh", " GWh", " GWh", " m/s", " m/s"];
    const nombres = ["Real", "Modelo", "Predicción de mañana", "Viento medio", "Racha"];
    const valores = [real, predLinea, tomorrowPoint, velData, rachaData];

    const grafica = new Chart(document.getElementById("predictionChart") as HTMLCanvasElement, {
      type: "bar",
      data: { labels, datasets },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: false,
        interaction: { mode: "index", intersect: false },
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: {
              title: (items: any[]) => {
                const i = items[0].dataIndex;
                return hasTomorrow && i === ultimo ? `${longDate(fechas[i])} · ${sufijo}` : longDate(fechas[i]);
              },
              label: (ctx: any) => {
                const v = ctx.parsed.y;
                if (v === null || v === undefined) return "";
                const esViento = ctx.dataset.yAxisID === "yWind";
                const origen = esViento ? (ctx.datasetIndex === 3 ? velOrig[ctx.dataIndex] : rachaOrig[ctx.dataIndex]) : null;
                const nota = origen === "prevision" ? " · previsión AEMET" : "";
                return ` ${ctx.dataset.label}: ${uno(Number(v))}${esViento ? " m/s" : " GWh"}${nota}`;
              },
            },
          },
        },
        scales: {
          x: { ticks: { maxRotation: 0, autoSkip: true, maxTicksLimit: 11 }, grid: { display: false } },
          yGen: { type: "linear", position: "left", beginAtZero: true, title: { display: true, text: "GWh" } },
          yWind: { type: "linear", position: "right", min: 0, title: { display: true, text: "m/s" }, grid: { drawOnChartArea: false } },
        },
      },
    });

    // Botones de serie
    raiz.querySelectorAll<HTMLButtonElement>("[data-pc-serie]").forEach((boton) => {
      boton.addEventListener("click", () => {
        const i = Number(boton.dataset.pcSerie);
        const visible = !grafica.isDatasetVisible(i);
        grafica.setDatasetVisibility(i, visible);
        boton.setAttribute("aria-pressed", String(visible));
        grafica.update("none");
      });
    });

    // Lectura del día y pasos (teclado y táctil)
    const visibles = () => [0, 1, 2, 3, 4].filter((i) => grafica.isDatasetVisible(i));
    conectarPasos(grafica, raiz, {
      total: () => labels.length,
      datasets: () => visibles().filter((d) => isNum(valores[d][0]) || valores[d].some(isNum)),
      vacio: "Pasa el ratón o toca la gráfica para ver los valores de cada día.",
      texto: (i) => {
        const fecha = hasTomorrow && i === ultimo ? `${longDate(fechas[i])} · ${sufijo}` : longDate(fechas[i]);
        const partes = visibles().filter((d) => isNum(valores[d][i])).map((d) => `${nombres[d]}: ${uno(valores[d][i] as number)}${unidades[d]}`);
        return [fecha, ...partes].join(" · ");
      },
    });

    // Las barras de viento llevan transparencia calculada: se repintan al cambiar de tema.
    window.addEventListener("aero-tema", () => {
      grafica.data.datasets[2].borderColor = token("bg");
      grafica.data.datasets[3].backgroundColor = relleno(velOrig, "sky", "73", "29");
      grafica.data.datasets[3].borderColor = borde(velOrig, "sky");
      grafica.data.datasets[4].backgroundColor = relleno(rachaOrig, "warm", "80", "29");
      grafica.data.datasets[4].borderColor = borde(rachaOrig, "warm");
      grafica.update("none");
    });
  }

  try {
    init();
  } catch {
    showError("No se ha podido dibujar la gráfica con la previsión publicada.");
  }
</script>
