---
// Real de los últimos 30 días completos + previsión publicada en el snapshot (CA-5.3).
import snapshot from "../../data/forecast-snapshot.json";
import { snapshotStatus, todayInMadrid } from "../../utils/forecast.mjs";

const buildStatus = snapshotStatus(snapshot, todayInMadrid());
---

<figure class="bg-white dark:bg-gray-800 rounded-xl p-4 shadow-md">
  <figcaption class="flex flex-wrap items-center justify-between gap-2 mb-3">
    <span class="text-base font-semibold text-gray-800 dark:text-white">
      Últimos 30 días completos y predicción de mañana
    </span>
    <span id="pc-subtitle" class="text-xs text-gray-500 dark:text-gray-400"></span>
  </figcaption>
  <div id="pc-error" class="hidden text-center py-10 text-red-700 dark:text-red-300 text-sm" role="alert"></div>
  <div id="pc-wrap" style="position:relative;height:340px;">
    <canvas id="predictionChart" role="img" aria-label="Gráfica de la generación eólica real de los últimos 30 días completos, las predicciones del modelo y la predicción de mañana" style="width:100%;height:340px;"></canvas>
  </div>
  <p id="pc-note" class="mt-2 text-xs text-gray-500 dark:text-gray-400" role="status" aria-live="polite">{buildStatus.mensaje}</p>
  <noscript>
    <p class="text-sm text-amber-700 dark:text-amber-300">Esta gráfica necesita JavaScript para dibujarse. La nota de arriba indica el estado de la previsión publicada.</p>
  </noscript>
</figure>

<script>
  import { Chart, registerables } from "chart.js";
  import snapshot from "../../data/forecast-snapshot.json";
  import { selectCompleteWindow, formatDateEs, formatNumber } from "../../utils/evolution.mjs";
  import { FORECAST_STATE, snapshotStatus, todayInMadrid } from "../../utils/forecast.mjs";

  Chart.register(...registerables);

  type Day = { fecha: string; eolica: number | null };
  type ChartData = {
    fechas_hist?: string[];
    real_gwh?: (number | null)[];
    pred_gwh?: (number | null)[];
    vel_ms?: (number | null)[];
    racha_ms?: (number | null)[];
    manana?: { fecha?: string; pred_gwh?: number | null; velmedia?: number | null; racha?: number | null; modelo?: string };
  };

  const WINDOW_DAYS = 30;
  const errorBox = document.getElementById("pc-error")!;
  const wrap = document.getElementById("pc-wrap")!;
  const subtitle = document.getElementById("pc-subtitle")!;
  const note = document.getElementById("pc-note")!;

  const isNum = (v: unknown): v is number => typeof v === "number" && Number.isFinite(v);
  const shortDate = (iso: string) => {
    const [, m, d] = iso.split("-");
    return `${Number(d)}/${Number(m)}`;
  };

  function showError(message: string) {
    wrap.classList.add("hidden");
    errorBox.textContent = message;
    errorBox.classList.remove("hidden");
  }

  /** Mapa fecha → valor a partir de dos listas paralelas. */
  function byDate(dates: string[] = [], values: (number | null)[] = []) {
    const map = new Map<string, number | null>();
    dates.forEach((d, i) => map.set(d, values[i] ?? null));
    return map;
  }

  function init() {
    const chart = (snapshot as { grafico?: ChartData }).grafico ?? null;
    const status = snapshotStatus(snapshot, todayInMadrid());

    // Serie real: el histórico trae 45 días para poder retroceder hasta 30 completos.
    const history = (snapshot as { historico?: Day[] }).historico ?? [];
    const series: Day[] = Array.isArray(history) ? history.map((d) => ({ fecha: d.fecha, eolica: d.eolica })) : [];
    const { days, discarded } = selectCompleteWindow(series, WINDOW_DAYS);
    if (days.length === 0) {
      showError("No hay datos de generación en la previsión publicada.");
      return;
    }

    const preds = byDate(chart?.fechas_hist, chart?.pred_gwh);
    const vel = byDate(chart?.fechas_hist, chart?.vel_ms);
    const racha = byDate(chart?.fechas_hist, chart?.racha_ms);

    const labels = days.map((d) => shortDate(d.fecha));
    const real = days.map((d) => (isNum(d.eolica) ? Math.round(d.eolica / 100) / 10 : null));
    const predHist = days.map((d) => preds.get(d.fecha) ?? null);
    const velData = days.map((d) => vel.get(d.fecha) ?? null);
    const rachaData = days.map((d) => racha.get(d.fecha) ?? null);

    // Predicción publicada: se muestra con su estado, nunca se rellena (D-9-18).
    const manana = chart?.manana;
    const hasTomorrow = status.estado !== FORECAST_STATE.UNAVAILABLE && isNum(manana?.pred_gwh);
    const tomorrowGWh = hasTomorrow ? Math.round((manana!.pred_gwh as number) * 10) / 10 : null;
    if (hasTomorrow) {
      const suffix = status.estado === FORECAST_STATE.STALE ? " (caducado)"
        : status.estado === FORECAST_STATE.PENDING ? " (hoy)" : " (mañana)";
      labels.push(`${shortDate(status.objetivo as string)}${suffix}`);
      real.push(null);
      predHist.push(tomorrowGWh);
      velData.push(isNum(manana?.velmedia) ? manana!.velmedia : null);
      rachaData.push(isNum(manana?.racha) ? manana!.racha : null);
    }
    const tomorrowPoint = labels.map((_, i) => (hasTomorrow && i === labels.length - 1 ? tomorrowGWh : null));

    subtitle.textContent = `Del ${formatDateEs(days[0].fecha)} al ${formatDateEs(days.at(-1)!.fecha)}`;
    const notes = [status.mensaje];
    if (days.length < WINDOW_DAYS) notes.push(`Solo hay ${days.length} días completos disponibles.`);
    if (discarded > 0) notes.push(`Se ${discarded === 1 ? "omite 1 día incompleto" : `omiten ${discarded} días incompletos`} al final de la serie.`);
    if (hasTomorrow) notes.push(`Producción prevista: ${formatNumber(tomorrowGWh as number, 1)} GWh.`);
    note.textContent = notes.join(" ");

    const hasWind = velData.some(isNum) || rachaData.some(isNum);
    const datasets: any[] = [
      {
        label: "Real (GWh)", type: "line", data: real, borderColor: "#2196F3", borderWidth: 2,
        pointRadius: 3, tension: 0.3, yAxisID: "yGen", order: 1,
      },
      {
        label: "Predicción del modelo (GWh)", type: "line", data: predHist, borderColor: "#FF5722",
        borderDash: [5, 4], borderWidth: 1.8, pointRadius: 3, pointStyle: "rectRot", tension: 0.3,
        spanGaps: true, yAxisID: "yGen", order: 1,
      },
      {
        label: "Predicción de mañana", type: "line", data: tomorrowPoint, borderColor: "#9C27B0",
        backgroundColor: "#9C27B0", pointRadius: 9, pointStyle: "rectRot", showLine: false,
        yAxisID: "yGen", order: 0,
      },
    ];
    if (hasWind) {
      datasets.push(
        { label: "Viento medio (m/s)", type: "bar", data: velData, backgroundColor: "rgba(128,203,196,0.55)", yAxisID: "yWind", order: 3 },
        { label: "Racha (m/s)", type: "bar", data: rachaData, backgroundColor: "rgba(255,179,0,0.5)", yAxisID: "yWind", order: 3 },
      );
    }

    new Chart(document.getElementById("predictionChart") as HTMLCanvasElement, {
      type: "bar",
      data: { labels, datasets },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: false,
        plugins: {
          legend: { position: "top", labels: { boxWidth: 12, font: { size: 11 }, color: "#9CA3AF" } },
          tooltip: {
            callbacks: {
              label: (ctx: any) => {
                const v = ctx.parsed.y;
                if (v === null || v === undefined) return "";
                const unit = ctx.dataset.yAxisID === "yWind" ? " m/s" : " GWh";
                return `${ctx.dataset.label}: ${Number(v).toLocaleString("es-ES")}${unit}`;
              },
            },
          },
        },
        scales: {
          x: { ticks: { font: { size: 9 }, color: "#9CA3AF", maxRotation: 0, autoSkip: true, maxTicksLimit: 12 }, grid: { display: false } },
          yGen: {
            type: "linear", position: "left",
            title: { display: true, text: "Generación eólica (GWh)", color: "#9CA3AF" },
            ticks: { color: "#9CA3AF" },
          },
          yWind: {
            type: "linear", position: "right", display: hasWind, min: 0,
            title: { display: true, text: "Viento (m/s)", color: "#9CA3AF" },
            ticks: { color: "#9CA3AF" }, grid: { drawOnChartArea: false },
          },
        },
      },
    });
  }

  try {
    init();
  } catch {
    showError("No se ha podido dibujar la gráfica con la previsión publicada.");
  }
</script>
