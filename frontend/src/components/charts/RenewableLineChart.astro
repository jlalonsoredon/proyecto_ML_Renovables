---
// Serie semanal recalculada desde la BD de referencia (P-9-11): solo semanas completas.
import series from "../../data/reference-series.json";

const { serieRenovable } = series;
const LABELS = serieRenovable.semanas;
const byName = (nombre: string) =>
  serieRenovable.tecnologias.find((t) => t.nombre === nombre)?.valores ?? [];
const EOLICA = byName("Eólica");
const SOLAR = byName("Solar fotovoltaica");
const HIDRO = byName("Hidráulica");
const SOLART = byName("Solar térmica");
const OTRAS = byName("Otras renovables");
const RESIDU = byName("Residuos renovables");
---

<div class="bg-white dark:bg-gray-800 rounded-xl p-4 shadow-md">
  <div class="mb-3">
    <h3 class="text-base font-semibold text-gray-800 dark:text-white">Evolución de Generación Renovable</h3>
    <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Generación semanal por tecnología. {serieRenovable.periodo}. Fuente: {serieRenovable.fuente}</p>
  </div>
  <div style="position:relative;height:320px;">
    <canvas id="renewableLineChart" style="width:100%;height:320px;" role="img" aria-label="Gráfica de líneas con la generación semanal de seis tecnologías renovables, en GWh"></canvas>
  </div>
</div>

<script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script is:inline define:vars={{ LABELS, EOLICA, SOLAR, HIDRO, SOLART, OTRAS, RESIDU }}>
(function () {
  function init() {
    if (typeof Chart === "undefined") { setTimeout(init, 50); return; }
    var ctx = document.getElementById("renewableLineChart");
    if (!ctx || ctx._rlcDone) return;
    ctx._rlcDone = true;

    new Chart(ctx, {
      type: "line",
      data: {
        labels: LABELS,
        datasets: [
          {
            label: "Eólica (GWh)",
            data: EOLICA,
            borderColor: "#2196F3",
            backgroundColor: "rgba(33,150,243,0.08)",
            borderWidth: 2,
            pointRadius: 0,
            tension: 0.3,
            fill: true,
            order: 1,
          },
          {
            label: "Solar FV (GWh)",
            data: SOLAR,
            borderColor: "#FF9800",
            backgroundColor: "rgba(255,152,0,0.08)",
            borderWidth: 2,
            pointRadius: 0,
            tension: 0.3,
            fill: true,
            order: 2,
          },
          {
            label: "Hidráulica (GWh)",
            data: HIDRO,
            borderColor: "#4CAF50",
            backgroundColor: "rgba(76,175,80,0.08)",
            borderWidth: 2,
            pointRadius: 0,
            tension: 0.3,
            fill: true,
            order: 3,
          },
          {
            label: "Solar Térmica (GWh)",
            data: SOLART,
            borderColor: "#FF5722",
            backgroundColor: "rgba(255,87,34,0.06)",
            borderWidth: 1.5,
            pointRadius: 0,
            tension: 0.3,
            fill: true,
            order: 4,
          },
          {
            label: "Otras renovables (GWh)",
            data: OTRAS,
            borderColor: "#9C27B0",
            backgroundColor: "rgba(156,39,176,0.06)",
            borderWidth: 1.5,
            pointRadius: 0,
            tension: 0.3,
            fill: true,
            order: 5,
          },
          {
            label: "Residuos reno. (GWh)",
            data: RESIDU,
            borderColor: "#607D8B",
            backgroundColor: "rgba(96,125,139,0.05)",
            borderWidth: 1.5,
            pointRadius: 0,
            tension: 0.3,
            fill: true,
            order: 6,
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: false,
        interaction: { mode: "index", intersect: false },
        plugins: {
          legend: {
            position: "top",
            labels: { boxWidth: 12, font: { size: 11 } },
          },
          tooltip: {
            callbacks: {
              label: function (ctx) {
                return ctx.dataset.label + ": " + ctx.parsed.y.toLocaleString("es-ES") + " GWh";
              },
            },
          },
        },
        scales: {
          x: {
            ticks: {
              font: { size: 9 },
              maxRotation: 0,
              autoSkip: true,
              maxTicksLimit: 12,
              callback: function (val, idx) {
                // Mostrar solo el año cuando cambia
                var label = this.getLabelForValue(val);
                return label ? label.slice(0, 7) : "";
              },
            },
            grid: { display: false },
          },
          y: {
            beginAtZero: true,
            title: { display: true, text: "GWh semanales", font: { size: 10 } },
            ticks: {
              font: { size: 9 },
              callback: function (v) { return v.toLocaleString("es-ES"); },
            },
            grid: { color: "rgba(0,0,0,0.05)" },
          },
        },
      },
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
})();
</script>