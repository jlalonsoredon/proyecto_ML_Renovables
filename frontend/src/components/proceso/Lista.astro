---
// Lista con marca de verificación (spec 016). Admite texto con <b> para el comienzo de cada punto.
interface Props {
  items: string[];
  token?: string;
}
const { items, token = "accent" } = Astro.props;
---

<ul class="lista">
  {items.map((item) => (
    <li>
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke={`var(--${token})`} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9.5l3.2 3.2L14 5.5" /></svg>
      <span set:html={item} />
    </li>
  ))}
</ul>

<style>
  .lista { margin: 0; padding: 0; list-style: none; }
  .lista li { display: flex; gap: 12px; align-items: flex-start; padding: 10px 0; border-top: 1px solid var(--line); font-size: 15px; color: var(--ink); text-wrap: pretty; }
  .lista svg { flex: none; margin-top: 3px; }
</style>
