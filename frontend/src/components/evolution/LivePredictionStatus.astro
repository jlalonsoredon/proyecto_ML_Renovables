---
// Estado de la previsión publicada: valores y estado salen del snapshot en build.
import snapshot from "../../data/forecast-snapshot.json";
import { cardView, toneClass } from "../../utils/live-prediction.mjs";

const view = cardView(snapshot);
const baseStatusClass = "text-sm font-medium";
---

<section
  class="bg-surface rounded-2xl p-6 border border-line border border-line"
  aria-labelledby="estado-actual-titulo"
  data-live-prediction
  data-state={view.estado}
>
  <h3 id="estado-actual-titulo" class="text-xl font-bold text-ink mb-1">
    Estado actual: predicción de mañana
  </h3>
  <p class="text-sm text-muted mb-4">
    Previsión publicada por el servicio de predicción. Se actualiza una vez al día.
  </p>

  <p data-field="estado" data-base-class={baseStatusClass} class={`${baseStatusClass} ${toneClass(view.tono)}`} role="status" aria-live="polite">
    {view.mensaje}
  </p>

  <dl class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 text-sm">
    <div>
      <dt class="text-muted">Producción prevista</dt>
      <dd class="text-2xl font-bold text-ink">
        <span data-field="valor">{view.campos.valor}</span> <span class="text-base font-normal">MWh</span>
      </dd>
    </div>
    <div>
      <dt class="text-muted">Fecha objetivo</dt>
      <dd class="font-semibold text-ink" data-field="fecha">{view.campos.fecha}</dd>
    </div>
    <div>
      <dt class="text-muted">Fecha de emisión</dt>
      <dd class="font-semibold text-ink" data-field="emision">{view.campos.emision}</dd>
    </div>
    <div>
      <dt class="text-muted">Familia del modelo</dt>
      <dd class="font-semibold text-ink" data-field="familia">{view.campos.familia}</dd>
    </div>
    <div>
      <dt class="text-muted">Número de variables</dt>
      <dd class="font-semibold text-ink" data-field="variables">{view.campos.variables}</dd>
    </div>
  </dl>

  <p class="mt-4 text-sm text-muted" data-field="version">{view.campos.version}</p>

</section>

<script>
  import snapshot from "../../data/forecast-snapshot.json";
  import { initLivePrediction } from "../../utils/live-prediction.mjs";
  initLivePrediction(snapshot);
</script>
