---
import timeline from "../../data/spec-timeline.json";

const CATEGORY_LABELS: Record<string, string> = {
  datos: "Datos",
  modelo: "Modelo",
  produccion: "Producción",
  interfaz: "Interfaz",
};

const CATEGORY_COLORS: Record<string, string> = {
  datos: "var(--sky)",
  modelo: "var(--accent)",
  produccion: "var(--violet)",
  interfaz: "var(--warm)",
};
---

<div>
  <p class="text-sm text-muted mb-6">
    Pulsa cada spec para ver la situación de partida, el cambio y el detalle técnico.
    Los términos técnicos se explican en el <a href="#glosario" class="underline text-brand">glosario</a>.
  </p>

  <ol class="border-l-2 border-line ml-3 space-y-6">
    {timeline.hitos.map((hito) => (
      <li class="relative ml-6">
        <span
          class="absolute -left-[35px] top-5 h-5 w-5 rounded-full border-4 bg-brand" style="border-color: var(--bg)"
          aria-hidden="true"
        ></span>
        <details
          open
          data-collapsible
          class="group bg-surface rounded-2xl border border-line border border-line"
        >
          <summary class="cursor-pointer list-none p-5 rounded-2xl focus:outline-none focus-visible:ring-2 focus-visible:ring-primary">
            <div class="flex flex-wrap items-center gap-2 mb-2">
              <span class="font-mono text-sm font-bold text-brand">Spec {hito.numero}</span>
              {hito.categorias.map((c) => (
                <span class="px-2 py-0.5 rounded-full text-xs font-semibold" style={`border: 1px solid ${CATEGORY_COLORS[c]}; color: ${CATEGORY_COLORS[c]}`}>
                  {CATEGORY_LABELS[c]}
                </span>
              ))}
              <span class="ml-auto text-xs text-muted">
                <span class="group-open:hidden">Ver detalle</span>
                <span class="hidden group-open:inline">Ocultar detalle</span>
              </span>
            </div>
            <h3 class="text-lg font-bold text-ink">{hito.titulo}</h3>
            <p class="mt-1 text-ink">{hito.resumen}</p>
          </summary>

          <div class="px-5 pb-5 space-y-3 text-sm text-ink border-t border-line pt-4">
            <p><strong class="text-ink">Situación de partida.</strong> {hito.partida}</p>
            <p><strong class="text-ink">Cambio.</strong> {hito.cambio}</p>
            <p><strong class="text-ink">Resultado.</strong> {hito.resultado}</p>
            {hito.cifras.length > 0 && (
              <dl class="bg-surface2/50 rounded-lg p-3 space-y-2">
                {hito.cifras.map((cifra) => (
                  <div>
                    <dt class="font-semibold text-ink">{cifra.concepto}</dt>
                    <dd>{cifra.valor}</dd>
                    <dd class="text-xs text-muted">Cómo se midió: {cifra.protocolo}</dd>
                  </div>
                ))}
              </dl>
            )}
            <p class="text-xs text-muted">
              <strong>Detalle técnico.</strong> {hito.detalle}
            </p>
          </div>
        </details>
      </li>
    ))}
  </ol>

  <section id="glosario" class="mt-10 bg-surface2 rounded-2xl p-6" aria-labelledby="glosario-titulo">
    <h3 id="glosario-titulo" class="text-lg font-bold text-ink mb-4">Glosario</h3>
    <dl class="grid gap-4 md:grid-cols-2 text-sm">
      {timeline.glosario.map((entrada) => (
        <div>
          <dt class="font-semibold text-ink">{entrada.termino}</dt>
          <dd class="text-ink">{entrada.definicion}</dd>
        </div>
      ))}
    </dl>
  </section>
</div>

<script>
  // Los hitos se generan abiertos para que se lean sin JavaScript (CA-1.8);
  // aquí se pliegan y, al imprimir, se abren todos (RNF-11).
  const hitos = [...document.querySelectorAll<HTMLDetailsElement>("details[data-collapsible]")];
  hitos.forEach((d) => (d.open = false));

  let previous: boolean[] = [];
  window.addEventListener("beforeprint", () => {
    previous = hitos.map((d) => d.open);
    hitos.forEach((d) => (d.open = true));
  });
  window.addEventListener("afterprint", () => {
    hitos.forEach((d, i) => (d.open = previous[i] ?? false));
  });
</script>
