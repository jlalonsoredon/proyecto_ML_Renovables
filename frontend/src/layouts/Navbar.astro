---
interface Props {
  ruta: string;
}
const { ruta } = Astro.props;
const enlaces = [
  { href: "/", texto: "Inicio" },
  { href: "/resultados", texto: "Resultados" },
  { href: "/proceso", texto: "Proceso" },
  { href: "/mejoras", texto: "Mejoras" },
];
const activo = (href: string) => (href === "/" ? ruta === "/" : ruta.startsWith(href));
---

<header class="a-nav">
  <div class="a-wrap">
    <nav class="a-nav-in" aria-label="Principal">
      <a href="/" class="a-logo" aria-label="AeroPredictor, inicio">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M12 12V22M12 12L4.5 7.7M12 12l7.5-4.3" />
          <circle cx="12" cy="12" r="1.6" fill="var(--accent)" />
        </svg>
        AERO<span>Predictor</span>
      </a>
      <div class="a-links">
        {enlaces.map((e) => <a href={e.href} aria-current={activo(e.href) ? "page" : undefined}>{e.texto}</a>)}
      </div>
      <button type="button" class="a-tema" data-tema aria-pressed="true" aria-label="Cambiar tema">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
        <span class="a-tema-txt" data-tema-txt>Oscuro</span>
      </button>
    </nav>
  </div>
</header>
