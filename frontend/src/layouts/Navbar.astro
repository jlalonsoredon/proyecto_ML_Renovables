---
// Cabecera del lienzo de diseño (spec 017): logo, enlaces y selector de tema Oscuro/Claro.
import Logo from "../components/shared/Logo.astro";

interface Props {
  ruta: string;
}
const { ruta } = Astro.props;
const enlaces = [
  { href: "/", texto: "Inicio" },
  { href: "/resultados", texto: "Resultados" },
  { href: "/proceso", texto: "Proceso" },
  { href: "/mejoras", texto: "Mejoras" },
];
const activo = (href: string) => (href === "/" ? ruta === "/" : ruta.startsWith(href));
---

<header class="nav-cab">
  <nav class="nav" aria-label="Principal">
    <a class="nav-logo" href="/" aria-label="AeroPredictor, ir al inicio"><Logo tam={22} /></a>
    <div class="nav-tema" role="group" aria-label="Tema de color">
      <button type="button" data-tema-modo="oscuro" aria-pressed="true" aria-label="Tema oscuro">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5z" /></svg>
        <span class="nav-tx">Oscuro</span>
      </button>
      <button type="button" data-tema-modo="claro" aria-pressed="false" aria-label="Tema claro">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
        <span class="nav-tx">Claro</span>
      </button>
    </div>
    <div class="nav-links">
      {enlaces.map((e) => <a href={e.href} aria-current={activo(e.href) ? "page" : undefined}>{e.texto}</a>)}
    </div>
  </nav>
</header>

<style>
  .nav-cab { position: sticky; top: 0; z-index: 50; background: var(--bg); border-bottom: 1px solid var(--line); }
  .nav { max-width: calc(1240px + 2 * clamp(20px, 5vw, 72px)); margin: 0 auto; padding: 10px clamp(20px, 5vw, 72px); min-height: 76px; display: flex; align-items: center; flex-wrap: wrap; gap: 6px 16px; }
  .nav-logo { order: 1; margin-right: auto; display: inline-flex; min-height: 44px; align-items: center; text-decoration: none; }
  .nav-tema { order: 2; display: inline-flex; gap: 2px; padding: 3px; border: 1px solid var(--line); border-radius: 999px; }
  .nav-tema button { display: inline-flex; align-items: center; gap: 8px; min-height: 40px; padding: 0 14px; border-radius: 999px; border: 0; font: 500 14px "Inter", system-ui, sans-serif; cursor: pointer; background: transparent; color: var(--ink); }
  .nav-tema button[aria-pressed="true"] { background: var(--accent); color: var(--accentInk); }
  .nav-links { order: 3; flex: 1 1 100%; display: flex; gap: 4px; flex-wrap: wrap; margin: 0 -6px; }
  .nav-links a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 12px; border-radius: 999px; font-size: 15px; font-weight: 500; color: var(--muted); text-decoration: none; }
  .nav-links a:hover { color: var(--ink); }
  .nav-links a[aria-current="page"] { background: var(--surface2); color: var(--ink); }
  @media (max-width: 640px) {
    .nav-tx { display: none; }
    .nav-tema button { padding: 0 12px; }
  }
  @media (min-width: 960px) {
    .nav-links { order: 2; flex: 0 1 auto; margin: 0; }
    .nav-links a { padding: 0 18px; }
    .nav-tema { order: 3; }
  }
</style>
