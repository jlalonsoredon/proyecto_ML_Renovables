---
const nav = [
  { href: "/", texto: "Inicio" },
  { href: "/resultados", texto: "Resultados" },
  { href: "/proceso", texto: "Proceso" },
  { href: "/mejoras", texto: "Mejoras" },
];
---

<footer class="a-foot">
  <div class="a-wrap">
    <div class="a-foot-grid">
      <div style="max-width: 32ch">
        <p class="a-logo" style="margin: 0 0 12px">AERO<span>Predictor</span></p>
        <p class="a-p" style="font-size: 14px">
          Predicción diaria de la generación eólica peninsular con Machine Learning, a partir de datos de AEMET y Red Eléctrica de España.
        </p>
        <p class="a-p" style="font-size: 13px; margin-top: 12px">Proyecto realizado para el bootcamp de Data Science de KeepCoding.</p>
      </div>
      <div>
        <h4>Navegación</h4>
        {nav.map((n) => <a href={n.href}>{n.texto}</a>)}
      </div>
      <div>
        <h4>Fuentes de datos</h4>
        <a href="https://opendata.aemet.es/" target="_blank" rel="noopener noreferrer">AEMET OpenData</a>
        <a href="https://www.ree.es/es/datos/apidata" target="_blank" rel="noopener noreferrer">Red Eléctrica de España</a>
      </div>
      <div>
        <h4>Contacto</h4>
        <a href="https://joseluisalonsoredondo.es/" target="_blank" rel="noopener noreferrer">Mi web</a>
        <a href="https://github.com/jlalonsoredon" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="https://www.linkedin.com/in/jose-luis-alonso-redondo/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      </div>
    </div>
  </div>
</footer>
